{
  "name": "reviewflow-team02",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db": "node scripts/local-mongo.mjs",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed-demo.js",
    "reset": "node server/scripts/reset-demo.js",
    "start": "node server/src/server.js",
    "dev": "node scripts/dev.mjs",
    "build": "vite build client",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "test:browser": "playwright test",
    "test:launcher": "node --test scripts/platform.test.mjs",
    "format": "prettier --write \"client/**/*.{js,jsx,css,html,svg}\" \"server/**/*.js\" \"scripts/*.mjs\" playwright.config.js package.json .prettierrc.json",
    "format:check": "prettier --check \"client/**/*.{js,jsx,css,html,svg}\" \"server/**/*.js\" \"scripts/*.mjs\" playwright.config.js package.json .prettierrc.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "mongoose": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.7.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "vite": "^6.4.0"
  }
}
