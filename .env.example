# Template only. Real passwords belong in your ignored .env file.
# These defaults start a separate local demo when I have not set up Atlas.
MONGO_URI=mongodb://127.0.0.1:28018/reviewflow?replicaSet=reviewflow
PORT=5050
REVIEWFLOW_DATABASE_MODE=local
# Optional: set SESSION_SECRET in .env. Otherwise I keep a persistent secret
# in ignored .local/session-secret.

# For our shared team database, replace the settings in .env with the private
# block I send you. Replace the placeholders there, not in this template.
# REVIEWFLOW_DATABASE_MODE=shared
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/reviewflow_team?retryWrites=true&w=majority&authSource=admin&appName=ReviewFlow-Team02
# PORT=5050
